font_enable_effects(font_pixelfy_lg, true, {
    dropShadowEnable: true,
    dropShadowSoftness: 30,     // Blur level (0 to 64)
    dropShadowOffsetX: 4,       // Shift right by 4 pixels
    dropShadowOffsetY: 4,       // Shift down by 4 pixels
    dropShadowColour: c_black,  // Shadow color
    dropShadowAlpha: 1        // Transparency (0 to 1)
});